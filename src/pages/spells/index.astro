---
import DnDLayout from "../../layouts/DnDLayout.astro";
import SpellList from "../../components/react/SpellList";
---

<DnDLayout title="Spells" activePage="spells">
  <div class="page-header">
    <div>
      <h1 class="page-title">✨ Spell Compendium</h1>
      <p class="page-subtitle">Browse D&D 5e spells (PHB, Xanathar's & Tasha's) — data from 5etools</p>
    </div>
  </div>

  <SpellList client:load />
</DnDLayout>
