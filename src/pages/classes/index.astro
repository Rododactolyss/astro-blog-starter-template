---
import DnDLayout from "../../layouts/DnDLayout.astro";
import { CLASSES } from "../../data/classes";

const CLASS_ICONS: Record<string, string> = {
  barbarian: "💢", bard: "🎵", cleric: "✝️", druid: "🌿",
  fighter: "⚔️", monk: "👊", paladin: "🛡️", ranger: "🏹",
  rogue: "🗡️", sorcerer: "🔮", warlock: "😈", wizard: "📚",
};
---

<DnDLayout title="Classes" activePage="classes">
  <div class="page-header">
    <div>
      <h1 class="page-title">📜 Classes</h1>
      <p class="page-subtitle">All 12 D&D 5e character classes from the System Reference Document</p>
    </div>
  </div>

  <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 16px;">
    {CLASSES.map(cls => (
      <div class="card">
        <div class="card-header">
          <div style="display: flex; align-items: center; gap: 10px;">
            <span style="font-size: 28px;">{CLASS_ICONS[cls.id] || "⚔️"}</span>
            <div>
              <h2 class="card-title" style="font-size: 18px;">{cls.name}</h2>
              <div style="font-size: 12px; color: var(--text-secondary);">
                Hit Die: d{cls.hitDie} · {cls.primaryAbility}
              </div>
            </div>
          </div>
          <div style="display: flex; flex-direction: column; gap: 4px; align-items: flex-end;">
            {cls.spellcaster && <span class="badge badge-blue">✨ Spellcaster</span>}
          </div>
        </div>
        <div class="card-body">
          <p style="font-size: 13px; color: var(--text-secondary); margin: 0 0 12px; line-height: 1.6;">
            {cls.description.slice(0, 180)}...
          </p>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px; font-size: 12px; margin-bottom: 12px;">
            <div style="background: var(--bg-secondary); padding: 8px; border-radius: 6px;">
              <div style="color: var(--text-muted); font-size: 10px; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 2px;">Saving Throws</div>
              <div style="font-weight: 600;">{cls.savingThrows.join(", ")}</div>
            </div>
            <div style="background: var(--bg-secondary); padding: 8px; border-radius: 6px;">
              <div style="color: var(--text-muted); font-size: 10px; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 2px;">Skill Choices</div>
              <div style="font-weight: 600;">{cls.skillChoices} skills</div>
            </div>
            <div style="background: var(--bg-secondary); padding: 8px; border-radius: 6px;">
              <div style="color: var(--text-muted); font-size: 10px; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 2px;">Armor</div>
              <div style="font-weight: 600; font-size: 11px;">{cls.armorProficiencies.slice(0,3).join(", ") || "None"}</div>
            </div>
            <div style="background: var(--bg-secondary); padding: 8px; border-radius: 6px;">
              <div style="color: var(--text-muted); font-size: 10px; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 2px;">{cls.subclassTitle}</div>
              <div style="font-weight: 600; font-size: 11px;">Level {cls.subclassLevel}</div>
            </div>
          </div>

          <details>
            <summary style="cursor: pointer; font-size: 12px; font-weight: 700; color: var(--accent-gold-light); padding: 4px 0; user-select: none;">
              Class Features ({cls.features.length})
            </summary>
            <div style="margin-top: 8px; max-height: 300px; overflow-y: auto;">
              {cls.features.map(f => (
                <div style="padding: 8px 0; border-bottom: 1px solid rgba(255,255,255,0.04);">
                  <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 8px;">
                    <span style="font-weight: 700; font-size: 13px; color: var(--accent-gold-light);">{f.name}</span>
                    <span style="font-size: 11px; color: var(--text-muted); white-space: nowrap;">Level {f.level}</span>
                  </div>
                  <p style="font-size: 12px; color: var(--text-secondary); margin: 4px 0 0; line-height: 1.5;">{f.description}</p>
                </div>
              ))}
            </div>
          </details>

          {cls.subclasses.length > 0 && (
            <details style="margin-top: 8px;">
              <summary style="cursor: pointer; font-size: 12px; font-weight: 700; color: var(--accent-gold-light); padding: 4px 0; user-select: none;">
                {cls.subclassTitle}s ({cls.subclasses.length})
              </summary>
              <div style="margin-top: 8px;">
                {cls.subclasses.map(sub => (
                  <div style="padding: 8px 0; border-bottom: 1px solid rgba(255,255,255,0.04);">
                    <div style="font-weight: 700; font-size: 13px; color: var(--text-primary); margin-bottom: 2px;">{sub.name}</div>
                    <p style="font-size: 12px; color: var(--text-secondary); margin: 0; line-height: 1.5;">{sub.description}</p>
                  </div>
                ))}
              </div>
            </details>
          )}
        </div>
      </div>
    ))}
  </div>
</DnDLayout>
