---
import DnDLayout from "../layouts/DnDLayout.astro";
import CharacterList from "../components/react/CharacterList";
---

<DnDLayout title="My Characters" activePage="characters">
  <div class="page-header">
    <div>
      <h1 class="page-title">My Characters</h1>
      <p class="page-subtitle">Manage your D&D 5e characters and adventures</p>
    </div>
    <a href="/characters/create" class="btn btn-primary btn-lg">
      ＋ Create New Character
    </a>
  </div>

  <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 12px; margin-bottom: 24px;">
    <a href="/spells" style="display: flex; align-items: center; gap: 12px; padding: 16px; background: var(--bg-card); border: 1px solid var(--border-color); border-radius: var(--radius-md); text-decoration: none; color: var(--text-primary); transition: all 0.15s; cursor: pointer;">
      <span style="font-size: 28px;">✨</span>
      <div>
        <div style="font-weight: 700; font-size: 15px;">Spell Compendium</div>
        <div style="font-size: 12px; color: var(--text-secondary);">Browse all spells</div>
      </div>
    </a>
    <a href="/monsters" style="display: flex; align-items: center; gap: 12px; padding: 16px; background: var(--bg-card); border: 1px solid var(--border-color); border-radius: var(--radius-md); text-decoration: none; color: var(--text-primary); transition: all 0.15s; cursor: pointer;">
      <span style="font-size: 28px;">🐉</span>
      <div>
        <div style="font-weight: 700; font-size: 15px;">Monster Manual</div>
        <div style="font-size: 12px; color: var(--text-secondary);">Full stat blocks</div>
      </div>
    </a>
    <a href="/dice" style="display: flex; align-items: center; gap: 12px; padding: 16px; background: var(--bg-card); border: 1px solid var(--border-color); border-radius: var(--radius-md); text-decoration: none; color: var(--text-primary); transition: all 0.15s; cursor: pointer;">
      <span style="font-size: 28px;">🎲</span>
      <div>
        <div style="font-weight: 700; font-size: 15px;">Dice Roller</div>
        <div style="font-size: 12px; color: var(--text-secondary);">Roll with advantage</div>
      </div>
    </a>
    <a href="/equipment" style="display: flex; align-items: center; gap: 12px; padding: 16px; background: var(--bg-card); border: 1px solid var(--border-color); border-radius: var(--radius-md); text-decoration: none; color: var(--text-primary); transition: all 0.15s; cursor: pointer;">
      <span style="font-size: 28px;">⚔️</span>
      <div>
        <div style="font-weight: 700; font-size: 15px;">Equipment</div>
        <div style="font-size: 12px; color: var(--text-secondary);">Weapons & armor</div>
      </div>
    </a>
  </div>

  <CharacterList client:load />
</DnDLayout>
